void mach1_d4_fwht(const uint d, const uint tid) {
    uint radix = 1u;
    if ((d & (d - 1u)) != 0u) {
        const uint m12 = d/12u;
        radix = (d % 12u == 0u && (m12 & (m12 - 1u)) == 0u) ? 12u : 20u;
    }
    const uint M = d/radix;
    for (uint span = 1u; span < M; span <<= 1) {
