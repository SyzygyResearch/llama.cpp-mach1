void main() {
    const uint b = gl_GlobalInvocationID.x;
    if (b >= M) {
        return;
    }
    const uint  gb    = gl_WorkGroupID.y*gstride;
    const uint  radix = d/M;
    const float scm   = sqrt(float(M));

    if (radix == 1u) {
        const uint i = gb + b*vstride;
        scr[i] = (scr[i] / scm) * float(scale[sc_off + b]);
        return;
    }
    float vals[20];
    for (uint c = 0; c < radix; ++c) {
        vals[c] = scr[gb + (c*M + b)*vstride] / scm;
    }
    const float rs = sqrt(float(radix));
    float t[20];
    for (uint a = 0; a < radix; ++a) {
        float acc = 0.0f;
        for (uint c = 0; c < radix; ++c) {
            const float hv = radix == 12u ? float(HR12[a*12u + c])
                                          : float(HR20[a*20u + c]);
            acc += hv * vals[c];
        }
        t[a] = acc / rs;
    }
    for (uint a = 0; a < radix; ++a) {
        scr[gb + (a*M + b)*vstride] = t[a] * float(scale[sc_off + a*M + b]);
    }
}
