#version 450

// Mach-1 expert tier, phase 3: y[:, s, t] = sv_e ⊙ H_m(v[:, pair]).
// One workgroup per pair; FWHT in shared memory.

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require

#define WG 256u

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint m;
    uint n_used;
    uint v_off;
    uint ids_s0;
    uint ids_s1;
};

layout(binding = 0) readonly buffer SvBuf { float16_t sv[]; };
layout(binding = 1) readonly buffer IBuf  { int ids[]; };
layout(binding = 2) readonly buffer FBuf  { float scr[]; };
layout(binding = 3) writeonly buffer DstBuf { float dst[]; };

shared float sh[2048];

void main() {
    // 2D grid (x = slot, y = token) so no dispatch dimension exceeds
    // max(n_used, n_tok) — stays under the spec-minimum 65535 limit
    const uint s   = gl_WorkGroupID.x;
    const uint t   = gl_WorkGroupID.y;
    const uint p   = t*n_used + s;
    const uint tid = gl_LocalInvocationID.x;
    const uint e   = uint(ids[s*ids_s0 + t*ids_s1]);

    for (uint i = tid; i < m; i += WG) {
        sh[i] = scr[v_off + p*m + i];
    }
    barrier();
    for (uint span = 1u; span < m; span <<= 1) {
        for (uint b = tid; b < m/2u; b += WG) {
            const uint base = (b / span) * (span << 1) + (b % span);
            const float a0 = sh[base];
            const float a1 = sh[base + span];
            sh[base]        = a0 + a1;
            sh[base + span] = a0 - a1;
        }
        barrier();
    }
    const float sc = sqrt(float(m));
    const uint obase = t*n_used*m + s*m;
    for (uint i = tid; i < m; i += WG) {
        dst[obase + i] = (sh[i] / sc) * float(sv[e*m + i]);
    }
}
